# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# PostgreSQL Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ticketbot
POSTGRES_USER=ticketbot
POSTGRES_PASSWORD=strong_password_here

# Bot Settings
BOT_PREFIX=!
LOG_LEVEL=INFO
MAX_TICKETS_PER_USER=5

# FoxholeHQ is checked only by explicit/periodic sync. Ticket creation uses PostgreSQL.
FOXHOLEHQ_BASE_URL=https://foxholehq.net
FOXHOLEHQ_SYNC_INTERVAL_HOURS=24
FOXHOLEHQ_MIN_ITEMS=100
FOXHOLE_WIKI_ENABLED=true
FOXHOLE_WIKI_API_URL=https://foxhole.wiki.gg/api.php
FOXHOLE_RESOLVE_AUTO_THRESHOLD=90
FOXHOLE_RESOLVE_CONFIRM_THRESHOLD=75
FOXHOLE_RESOURCE_COST_DISPLAY=both
FOXHOLE_RESOURCE_BMAT=BMat
FOXHOLE_RESOURCE_RMAT=RMat
FOXHOLE_RESOURCE_EMAT=EMat
FOXHOLE_RESOURCE_HEMAT=HEMat

# Existing deployments keep POSTGRES_* authoritative.
# Set DATABASE_URL_MODE=explicit only when intentionally using DATABASE_URL.
DATABASE_URL_MODE=components
# Optional logistics integration. Issue a guild-scoped BOT token on the server.
# In Compose use BACKEND_URL=http://backend:8000
BACKEND_URL=
BACKEND_TOKEN=
BACKEND_PORT=8000
# Standalone bot only; Compose runs the migrate service instead.
DB_MIGRATE_ON_STARTUP=true
